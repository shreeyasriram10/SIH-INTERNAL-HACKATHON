# Copy to .env and adjust. Never commit the real .env.

# JWT signing key. REQUIRED in any deployment: without it the app generates a
# random key per process and sessions stop working across restarts.
LOHA_SECRET_KEY=change-me-to-a-long-random-string

# Access-token lifetime, minutes.
LOHA_TOKEN_TTL_MIN=720

# Comma-separated CORS allow-list. The dashboard is same-origin, so this only
# matters for a separately hosted front end.
LOHA_CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Password assigned to the seeded demo accounts.
LOHA_DEMO_PASSWORD=12345

# Reset the three demo accounts' password hash and role on every boot.
# Set to 0 in production so real accounts are never rewritten.
LOHA_REPAIR_DEMO_ACCOUNTS=1

LOHA_LOG_LEVEL=INFO
